    {
      "name": "02 - Create User - Success",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"User successfully created with safe properties\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.data).to.have.property(\"id\");",
              "    pm.expect(jsonData.data.fullName).to.eql(\"Rahul Sharma\");",
              "    pm.expect(jsonData.data.email).to.eql(\"rahul.sharma@example.com\");",
              "    pm.expect(jsonData.data).to.have.property(\"createdAt\");",
              "",
              "    // Security: ensure password and hash are NEVER returned",
              "    pm.expect(jsonData.data.password).to.be.undefined;",
              "    pm.expect(jsonData.data.passwordHash).to.be.undefined;",
              "    pm.expect(jsonData.data._id).to.be.undefined;",
              "    pm.expect(jsonData.data.__v).to.be.undefined;",
              "",
              "    // Auto-save created userId for subsequent requests",
              "    pm.collectionVariables.set(\"userId\", jsonData.data.id);",
              "    console.log(\"Saved userId to collection variable: \" + jsonData.data.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Rahul Sharma\",\n  \"email\": \"rahul.sharma@example.com\",\n  \"password\": \"SecurePassword123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/users",
          "host": ["{{baseUrl}}"],
          "path": ["api", "users"]
        },
        "description": "Creates a new user. The returned user id is automatically saved to the collection variable {{userId}}."
      },
      "response": []
    },
